# bl-halo-mcp - copy to .env and fill in
# Backend / webapp ports (claimed 11976/11977)
BL_HALO_BACKEND_PORT=11976
BL_HALO_FRONTEND_PORT=11977
WEB_PORT=11976
VITE_PORT=11977
VITE_API_TARGET=http://127.0.0.1:11976
# Halo connection - blank = MOCK / emulator mode
BL_HALO_DEVICE_MAC=
BL_HALO_DEVICE_NAME=Halo
BL_HALO_API_URL=http://127.0.0.1:11976
BL_HALO_MOCK=true
# Noa cloud (optional, ONLY noa_ask needs it - everything else is local/keyless).
# Paste a preview key from https://github.com/brilliantlabsAR/noa-playground
# (API key box). Blank = labeled MOCK answers. Unofficial integration.
NOA_API_KEY=
NOA_API_URL=https://api.brilliant.xyz/dev/noa
